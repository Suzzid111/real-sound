{
  "rewrites": [
    {
      "source": "/join",
      "destination": "/index.html"
    },
    {
      "source": "/h/:slug",
      "destination": "/api/h?s=:slug"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 14 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "realsoundhealing.com"
        }
      ],
      "destination": "https://realholisticnetwork.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.realsoundhealing.com"
        }
      ],
      "destination": "https://realholisticnetwork.com/:path*",
      "permanent": true
    }
  ]
}
