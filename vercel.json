{
  "rewrites": [
    {
      "source": "/join",
      "destination": "/index.html"
    },
    {
      "source": "/h/:slug",
      "destination": "/api/h?s=:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?t=sitemap"
    },
    {
      "source": "/healers",
      "destination": "/api/seo?t=healers"
    },
    {
      "source": "/healer/:slug",
      "destination": "/api/seo?t=healer&s=:slug"
    },
    {
      "source": "/shops",
      "destination": "/api/seo?t=shops"
    },
    {
      "source": "/shops/:st",
      "destination": "/api/seo?t=shops&st=:st"
    }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 14 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "realsoundhealing.com"
        }
      ],
      "destination": "https://realholisticnetwork.com/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.realsoundhealing.com"
        }
      ],
      "destination": "https://realholisticnetwork.com/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/seo.js": {
      "includeFiles": "shops-data.js"
    }
  }
}